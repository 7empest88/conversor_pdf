# Entorno virtual de Python
.venv/
venv/
env/

# Archivos compilados y caché de Python
__pycache__/
*.py[cod]
*$py.class

# Archivos temporales y de registro
*.log
*.tmp
*.temp

# Archivos generados por la aplicación
*.pdf

# Documentos cargados o usados para pruebas
*.xlsx
*.xls
*.xlsm
*.xlsb
*.doc
*.docx
*.docm
*.dotx
*.dotm
*.ppt
*.pptx
*.pptm
*.potx
*.potm

# Configuración privada o variables de entorno
.env
.env.*
*.secret
secrets.json
config.local.py

# Configuración local de VS Code
.vscode/
!.vscode/extensions.json

# Archivos propios de Windows y macOS
Thumbs.db
Desktop.ini
.DS_Store

# Archivos de empaquetado o distribución
build/
dist/
*.egg-info/
